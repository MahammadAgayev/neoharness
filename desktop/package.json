{
  "name": "neoharness-desktop",
  "productName": "neoharness",
  "version": "0.1.0",
  "private": true,
  "description": "The neoharness desktop app: the TUI's sessions in a window, on the same hub.",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "package:app": "electron-packager . neoharness --platform=darwin --out=dist --overwrite --icon=build/icon.icns --app-bundle-id=dev.neoharness.desktop --ignore=\"^/(src|test|test-results|playwright-report|build|dist)($|/)\" --ignore=\"\\.(ts|md)$\"",
    "dist": "electron-vite build && npm run package:app && codesign --force --deep --sign - dist/neoharness-darwin-*/neoharness.app"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron/packager": "^20.3.0",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.65.0",
    "@replit/codemirror-vim": "^6.4.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.4.17",
    "electron": "^45.3.1",
    "electron-vite": "^6.0.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
